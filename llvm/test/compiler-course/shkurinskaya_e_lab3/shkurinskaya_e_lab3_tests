# RUN: llc -mtriple=x86_64-pc-linux-gnu -mattr=+fma \
# RUN:     --load=%llvmshlibdir/FmaCombinePass_Shkurinskaya_Elena_FIIT2_BACKEND%shlibext \
# RUN:     -run-pass=fma-combine %s -o - | FileCheck %s
--- |
  ; ModuleID = './llvm/test/compiler-course/technoir/test12.mir'
  source_filename = "./llvm/test/compiler-course/technoir/test1.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  
  define void @test_fuse_scalar_f32(ptr %a, ptr %b, ptr %c, ptr %d) #0 {
  entry:
    %a0 = load float, ptr %a, align 4
    %b0 = load float, ptr %b, align 4
    %m0 = fmul float %a0, %b0
    %c0 = load float, ptr %c, align 4
    %s0 = fsub float %c0, %m0
    store float %s0, ptr %d, align 4
    ret void
  }
  
  define void @test_fuse_vector4_f32(ptr %a, ptr %b, ptr %c, ptr %d) #0 {
  entry:
    %a1 = load <4 x float>, ptr %a, align 16
    %b1 = load <4 x float>, ptr %b, align 16
    %m1 = fmul <4 x float> %a1, %b1
    %c1 = load <4 x float>, ptr %c, align 16
    %s1 = fsub <4 x float> %c1, %m1
    store <4 x float> %s1, ptr %d, align 16
    ret void
  }
  
  define void @test_fuse_scalar_f64(ptr %a, ptr %b, ptr %c, ptr %d) #0 {
  entry:
    %a2 = load double, ptr %a, align 8
    %b2 = load double, ptr %b, align 8
    %m2 = fmul double %a2, %b2
    %c2 = load double, ptr %c, align 8
    %s2 = fsub double %c2, %m2
    store double %s2, ptr %d, align 8
    ret void
  }
  
  define void @test_fuse_vector2_f64(ptr %a, ptr %b, ptr %c, ptr %d) #0 {
  entry:
    %a3 = load <2 x double>, ptr %a, align 16
    %b3 = load <2 x double>, ptr %b, align 16
    %m3 = fmul <2 x double> %a3, %b3
    %c3 = load <2 x double>, ptr %c, align 16
    %s3 = fsub <2 x double> %c3, %m3
    store <2 x double> %s3, ptr %d, align 16
    ret void
  }
  
  define void @test_no_fuse_add(ptr %a, ptr %b, ptr %c, ptr %d) #0 {
  entry:
    %a4 = load float, ptr %a, align 4
    %b4 = load float, ptr %b, align 4
    %x4 = fadd float %a4, %b4
    %c4 = load float, ptr %c, align 4
    %s4 = fsub float %c4, %x4
    store float %s4, ptr %d, align 4
    ret void
  }
  
  attributes #0 = { "target-cpu"="znver3" "target-features"="+fma" }

...
