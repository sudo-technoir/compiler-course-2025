callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    liveins: $rdi, $rsi, $rdx, $rcx
  
    %3:gr64 = COPY $rcx
    %2:gr64 = COPY $rdx
    %1:gr64 = COPY $rsi
    %0:gr64 = COPY $rdi
    %4:fr32 = MOVSSrm_alt %0, 1, $noreg, 0, $noreg :: (load (s32) from %ir.a)
    %7:fr32 = VFMSUB213SSr %4, %1, %6, 0, implicit $mxcsr, implicit $mxcsr, implicit $mxcsr
    %6:fr32 = MOVSSrm_alt %2, 1, $noreg, 0, $noreg :: (load (s32) from %ir.c)
